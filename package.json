{
  "name": "cafe-recommender",
  "version": "1.0.0",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:web": "npm run site && npm run build --prefix web",
    "test:web": "npm test --prefix web",
    "check-keys": "node scripts/check-keys.mjs",
    "discover": "tsx --env-file-if-exists=.env src/cli/run.ts discover",
    "buzz": "tsx --env-file-if-exists=.env src/cli/run.ts buzz",
    "classify": "tsx --env-file-if-exists=.env src/cli/run.ts classify",
    "label": "tsx --env-file-if-exists=.env src/cli/run.ts label",
    "suggest": "tsx --env-file-if-exists=.env src/cli/run.ts suggest",
    "drive": "tsx --env-file-if-exists=.env src/cli/run.ts drive",
    "site": "tsx --env-file-if-exists=.env src/cli/run.ts site",
    "notify": "tsx --env-file-if-exists=.env src/cli/run.ts notify",
    "visited": "tsx --env-file-if-exists=.env src/cli/run.ts visited",
    "inspect": "tsx --env-file-if-exists=.env src/cli/run.ts inspect",
    "prune-raw": "tsx --env-file-if-exists=.env src/cli/run.ts prune-raw",
    "health": "tsx --env-file-if-exists=.env src/cli/run.ts health",
    "hide": "tsx --env-file-if-exists=.env src/cli/run.ts hide",
    "watch": "tsx --env-file-if-exists=.env src/cli/run.ts watch",
    "normalize": "tsx --env-file-if-exists=.env src/cli/run.ts normalize",
    "audit": "tsx --env-file-if-exists=.env src/cli/run.ts audit",
    "requeue": "tsx --env-file-if-exists=.env src/cli/run.ts requeue",
    "liveness": "tsx --env-file-if-exists=.env src/cli/run.ts liveness",
    "restaurant-discover": "tsx --env-file-if-exists=.env src/cli/run.ts restaurant-discover",
    "restaurant-buzz": "tsx --env-file-if-exists=.env src/cli/run.ts restaurant-buzz",
    "restaurant-classify": "tsx --env-file-if-exists=.env src/cli/run.ts restaurant-classify",
    "restaurant-suggest": "tsx --env-file-if-exists=.env src/cli/run.ts restaurant-suggest",
    "restaurant-liveness": "tsx --env-file-if-exists=.env src/cli/run.ts restaurant-liveness",
    "restaurant-drive": "tsx --env-file-if-exists=.env src/cli/run.ts restaurant-drive",
    "nearby-drive": "tsx --env-file-if-exists=.env src/cli/run.ts nearby-drive",
    "spot-discover": "tsx --env-file-if-exists=.env src/cli/run.ts spot-discover",
    "spot-buzz": "tsx --env-file-if-exists=.env src/cli/run.ts spot-buzz",
    "spot-classify": "tsx --env-file-if-exists=.env src/cli/run.ts spot-classify",
    "spot-suggest": "tsx --env-file-if-exists=.env src/cli/run.ts spot-suggest",
    "spot-liveness": "tsx --env-file-if-exists=.env src/cli/run.ts spot-liveness",
    "spot-drive": "tsx --env-file-if-exists=.env src/cli/run.ts spot-drive"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
