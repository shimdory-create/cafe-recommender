# ==========================================================
#  cafe-recommender 환경변수 (v3)
#  이 파일을 복사해 .env 로 만들고 값을 채우세요.
#    cp .env.example .env
#  .env 는 .gitignore 로 차단되어 있습니다. 절대 커밋되지 않습니다.
#
#  관리할 키는 2개입니다: 카카오 하나, LLM 하나.
# ==========================================================

# --- 카카오 (developers.kakao.com) -------------------------
# 내 애플리케이션 > [앱 설정] > 앱 키 > "REST API 키"
#   네 개 중 세 번째입니다. JavaScript 키나 네이티브 앱 키가 아닙니다.
# [제품 설정] > 카카오맵 > 활성화 ON 이 필수입니다.
#   안 하면 403 App(...) disabled OPEN_MAP_AND_LOCAL service. 가 납니다.
# 이 키 하나로 장소 검색과 블로그 검색을 모두 합니다.
KAKAO_REST_API_KEY=

# --- LLM ---------------------------------------------------
# gemini(무료 티어) 또는 anthropic. 기본값 gemini.
LLM_PROVIDER=gemini

# Gemini: aistudio.google.com/apikey
#   결제 수단 등록 없이 발급됩니다. LLM_PROVIDER=gemini 일 때 필요.
GEMINI_API_KEY=

# Anthropic: console.anthropic.com
#   LLM_PROVIDER=anthropic 일 때만 필요. 선불 크레딧이 있어야 합니다.
ANTHROPIC_API_KEY=

# --- 저장소 ------------------------------------------------
# DB 없음. JSON 파일이 git 에 커밋됩니다 (스펙 v3 9절).
DATA_DIR=data

# --- 출발지: 인천 부평구 수변로 334 (기본값 있음. 비워두어도 됩니다) ----
HOME_LAT=37.5151091
HOME_LNG=126.7398273

# ==========================================================
#  쓰지 않는 것
#    네이버 검색 API — 2026-06-25 NAVER API HUB(NCP)로 이관되어
#      신규 발급 경로가 없습니다. 카카오 블로그 검색으로 대체했습니다.
#    Supabase — 쓰기 기능이 0개로 줄어 DB가 필요 없어졌습니다.
# ==========================================================
