# ==========================================================
#  cafe-recommender 환경변수
#  이 파일을 복사해 .env 로 만들고 값을 채우세요.
#    cp .env.example .env
#  .env 는 .gitignore 로 차단되어 있습니다. 절대 커밋되지 않습니다.
# ==========================================================

# --- 카카오 (developers.kakao.com) -----------------------
# 내 애플리케이션 > 앱 키 > "REST API 키"
# JavaScript 키나 네이티브 앱 키가 아닙니다.
KAKAO_REST_API_KEY=

# --- 네이버 (developers.naver.com) -----------------------
# Application > 내 애플리케이션 > 개요
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- Supabase (supabase.com) ------------------------------
# Project Settings > API
# service_role 키는 RLS를 우회합니다. 서버 배치에서만 쓰고
# 브라우저로 절대 내려보내지 않습니다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (console.anthropic.com) -------------------
ANTHROPIC_API_KEY=

# --- 출발지: 인천 부평 (기본값 있음. 비워두어도 됩니다) ---
HOME_LAT=37.5074
HOME_LNG=126.7218
